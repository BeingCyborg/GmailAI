{
  "manifest_version": 3,
  "name": "Gmail AI Reply",
  "version": "1.0.0",
  "description": "AI-powered email reply assistant for Gmail — generates clarifying questions and drafts replies using Google Gemini.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.google.com/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.tsx-loader-CgAj9u5N.js"
      ],
      "matches": [
        "https://mail.google.com/*"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "assets/gmailjs-loader.ts-Ch4GJXYe.js"
      ],
      "matches": [
        "https://mail.google.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": "icons/Icon_logo.png"
  },
  "icons": {
    "16": "icons/Icon_logo.png",
    "32": "icons/Icon_logo.png",
    "48": "icons/Icon_logo.png",
    "128": "icons/Icon_logo.png"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "resources": [
        "assets/client-DhEz86-d.js",
        "assets/index.tsx-DkhYAXXm.js",
        "assets/gmailjs-loader.ts-Ch4GJXYe.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
