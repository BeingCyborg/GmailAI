{
  "manifest_version": 3,
  "name": "Gmail AI Reply",
  "version": "1.0.0",
  "description": "AI-powered email reply assistant for Gmail — generates clarifying questions and drafts replies using Google Gemini.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://mail.google.com/*"],
  "background": {
    "service_worker": "src/background/index.ts"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/content/index.tsx"]
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": "icons/Icon_logo.png"
  },
  "icons": {
    "16": "icons/Icon_logo.png",
    "32": "icons/Icon_logo.png",
    "48": "icons/Icon_logo.png",
    "128": "icons/Icon_logo.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["pageWorld.js"],
      "matches": ["https://mail.google.com/*"]
    }
  ]
}
